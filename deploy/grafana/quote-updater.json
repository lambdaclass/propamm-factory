  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      },
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(quote_updater_target_blocks_total, pair)",
        "hide": 0,
        "includeAll": true,
        "label": "Pair",
        "multi": true,
        "name": "pair",
        "options": [],
        "query": {
          "query": "label_values(quote_updater_target_blocks_total, pair)",
          "refId": "PrometheusVariableQueryEditor-pair"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(quote_updater_builder_up, builder)",
