    {
      "id": 8,
      "type": "table",
      "title": "Pair summary",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "quote_updater_feed_up{pair=~\"$pair\"}",
          "refId": "A",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "quote_updater_breaker_armed{pair=~\"$pair\"} + quote_updater_breaker_tripped{pair=~\"$pair\"}",
          "refId": "B",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "quote_updater_signer_runway_updates{pair=~\"$pair\"}",
          "refId": "C",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "feed"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "DOWN",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "up",
                        "color": "green",
                        "index": 1
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "nan",
                      "result": {
                        "text": "no feed",
                        "color": "text",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "breaker"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "UNGUARDED",
                        "color": "orange",
                        "index": 0
                      },
                      "1": {
                        "text": "armed",
                        "color": "green",
                        "index": 1
                      },
                      "2": {
                        "text": "TRIPPED",
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "runway"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "yellow",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1000
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "pair",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(pair|Value #A|Value #B|Value #C)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {},
            "renameByName": {
              "Value #A": "feed",
              "Value #B": "breaker",
              "Value #C": "runway"
            }
          }
        }
      ]
    },
