# Local chain state and generated configs (make local, make price-service, make quickstart).
/.local/
/example/.local.toml

# Rust build output: the workspace, the example binary and the e2e's downstream crate.
/target/
/example/target/
/e2e/downstream/target/
/e2e/__pycache__/

# Secrets.
.env
/quote-updater/config.toml

# The production deployment's filled-in files (deploy/README.md).
/deploy/.env
/deploy/config/*
!/deploy/config/.gitkeep
/deploy/alertmanager/slack-webhook

# direnv's cache of the flake shell.
/.direnv/
